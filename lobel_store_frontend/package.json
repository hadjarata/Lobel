{
  "name": "lobel_store_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:lan": "vite --host",
    "validate:env": "node scripts/validate-env.mjs",
    "test:env": "node --test scripts/**/*.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "vitest run src/auth src/components/auth src/context",
    "test:contracts": "vitest run src/api/contracts",
    "test:catalog": "vitest run src/catalog src/components/ui/Pagination.test.jsx",
    "test:cart": "vitest run src/cart",
    "test:checkout": "vitest run src/api/checkout.test.js",
    "test:payments": "vitest run src/payments src/api/contracts",
    "test:orders": "vitest run src/orders",
    "build": "npm run build:production",
    "build:production": "node scripts/validate-env.mjs --mode production && vite build --mode production",
    "build:staging": "node scripts/validate-env.mjs --mode staging && vite build --mode staging",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "1.18.1",
    "country-telephone-data": "^0.6.3",
    "framer-motion": "^12.42.2",
    "libphonenumber-js": "^1.10.31",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "7.18.1",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
