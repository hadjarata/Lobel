# Toutes les variables VITE_* sont publiques et intégrées au bundle navigateur.
# Ne placez jamais ici de mot de passe, token, PRIVATE_KEY, clé API secrète,
# secret Django ou clé secrète LigdiCash.

# Développement local — copier ce fichier vers .env.local si nécessaire.
VITE_APP_ENV=development
VITE_APP_NAME=LobelStore
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEV_BACKEND_TARGET=http://127.0.0.1:8000
VITE_ENABLE_PAYMENT_MOCK=true
VITE_ENABLE_DEBUG_LOGS=true

# Staging — valeurs d'exemple à injecter dans la plateforme.
# VITE_APP_ENV=staging
# VITE_APP_NAME=LobelStore Staging
# VITE_API_BASE_URL=https://api-staging.example.invalid
# VITE_ENABLE_PAYMENT_MOCK=false
# VITE_ENABLE_DEBUG_LOGS=false

# Production — VITE_APP_ENV et VITE_API_BASE_URL sont obligatoires.
# VITE_APP_ENV=production
# VITE_APP_NAME=LobelStore
# VITE_API_BASE_URL=https://api.example.invalid
# VITE_ENABLE_PAYMENT_MOCK=false
# VITE_ENABLE_DEBUG_LOGS=false

# .env.development.local
VITE_API_BASE_URL=http://127.0.0.1:8000
