# LobelStore environment template — contains no real secret.
# Development values must never be copied unchanged to production.

# Django environment
DJANGO_SETTINGS_MODULE=lobel_store.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_PATH=admin
ENABLE_API_DOCS=true

# PostgreSQL
DATABASE_NAME=lobel_store_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_CONN_MAX_AGE=60
# Production: require, verify-ca or preferably verify-full.
DATABASE_SSLMODE=require

# Frontend, CORS and CSRF
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=
EMAIL_VERIFICATION_FRONTEND_URL=
FRONTEND_RESET_PASSWORD_URL=
FRONTEND_EMAIL_ACTIVATION_URL=
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CORS_ALLOW_CREDENTIALS=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_USE_X_FORWARDED_HOST=true

# HTTPS and progressive HSTS
DJANGO_SECURE_HSTS_SECONDS=300
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# JWT and proxy identification
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
DRF_NUM_PROXIES=0

# SMTP — production requires real values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Payments — mock is development/test only.
PAYMENT_PROVIDER=mock
LIGDICASH_API_KEY=
LIGDICASH_API_TOKEN=
LIGDICASH_BASE_URL=https://app.ligdicash.com
LIGDICASH_STORE_NAME=LobelStore
LIGDICASH_STORE_URL=
LIGDICASH_RETURN_URL=
LIGDICASH_CANCEL_URL=
LIGDICASH_CALLBACK_URL=
LIGDICASH_ENVIRONMENT=integration
LIGDICASH_HTTP_TIMEOUT=15
LIGDICASH_VERIFY_TLS=true
LIGDICASH_ALLOWED_CHECKOUT_HOSTS=app.ligdicash.com
ORDER_PENDING_PAYMENT_TTL_MINUTES=60

# Media and upload limits
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_STORAGE_IS_PERSISTENT=false
MEDIA_PERSISTENT_ROOT=
MEDIA_BUCKET_NAME=
MEDIA_ENDPOINT_URL=
MEDIA_PUBLIC_BASE_URL=
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=50
MAX_PRODUCT_IMAGES=10
MAX_PRODUCT_VIDEOS=2
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_DURATION_SECONDS=120
MAX_VIDEO_WIDTH=1920
MAX_VIDEO_HEIGHT=1080
MAX_VIDEO_TRACKS=4
FFPROBE_PATH=
FFPROBE_TIMEOUT_SECONDS=10

# API
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
API_MAX_SEARCH_LENGTH=100

# Production logging
DJANGO_LOG_LEVEL=INFO

# Gunicorn
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
